# Copy this file to .env and fill in real values locally.
# Do not commit .env itself.

LOG_LEVEL=INFO

# Gemini is used for vision, descriptions, translation, and SEO.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated browser origins. Add deployed frontend origin(s) in production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000
# Whisper downloads/loads this local model on first real use.
WHISPER_MODEL_SIZE=base
