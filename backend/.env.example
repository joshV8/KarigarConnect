ENVIRONMENT=development
ALLOWED_ORIGINS=*
DATABASE_URL=postgresql://username:password@localhost:5432/artisan_db
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=artisan/products

# AI Service Configuration (Person 2 AI Integration)
AI_MODE=mock
AI_SERVICE_URL=http://localhost:9000
AI_SERVICE_TIMEOUT=60

# Pricing Engine Configuration
ARTISAN_MARGIN_PERCENT=20
DEFAULT_MARKET_ADJUSTMENT=0
DEFAULT_DEMAND_ADJUSTMENT=0

# Firebase Authentication Configuration
AUTH_MODE=mock
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CREDENTIALS_PATH=
